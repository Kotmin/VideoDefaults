#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
VALIDATOR="$REPO_ROOT/tools/commit-check/validate_commit_message.py"
tmpfile="$(mktemp)"
trap 'rm -f "$tmpfile"' EXIT

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    commits="$(git rev-list "$local_sha" --not --remotes 2>/dev/null || true)"
  else
    commits="$(git rev-list "$remote_sha..$local_sha" 2>/dev/null || true)"
  fi

  while IFS= read -r sha; do
    [ -n "$sha" ] || continue
    git log -1 --format='%B' "$sha" > "$tmpfile"
    if ! python3 "$VALIDATOR" "$tmpfile" 2>&1; then
      echo "pre-push: rejected at commit $sha" >&2
      exit 1
    fi
  done <<< "$commits"
done
